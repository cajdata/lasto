{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(*--live*)",
      "PowerShell(*--live*)"
    ],
    "ask": [
      "Edit(/src/lasto/safety/**)",
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)"
    ],
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(uv run pytest *)",
      "Bash(uv run python -m pytest *)",
      "Bash(lasto *)",
      "Bash(python -m lasto *)",
      "Bash(uv run lasto *)",
      "PowerShell(python -m pytest *)",
      "PowerShell(uv run pytest *)",
      "PowerShell(uv run python -m pytest *)",
      "PowerShell(lasto *)",
      "PowerShell(python -m lasto *)",
      "PowerShell(uv run lasto *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|Agent|Task|Workflow|mcp__terminal__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/hardware_guard.py\"",
            "timeout": 15,
            "statusMessage": "lasto hardware guard"
          }
        ]
      }
    ]
  }
}
